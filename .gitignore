# 根级依赖与缓存（嵌套子项目各自保留其 .gitignore 规则）
node_modules/
.pnpm-store/
.trae/

# 嵌套仓库 git 历史备份（不移除文件本身，仅不入库）
references/deepseek-harness/.git.bak/
references/OpenMAIC/.git.bak/
OpenTeach/.git.bak/
# OpenTeach 运行期提示词软链：bundle 按 cwd/lib/prompts 读取，指向 assets/prompts
OpenTeach/lib/prompts/

# 第三方参考仓库（只读参考，不入库）
references/

# 根级环境与日志兜底
.env
*.log
